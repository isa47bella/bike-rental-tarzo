# ============================================================
# ARFANTA BIKE RENTAL — Variabili d'ambiente Backend
# Copia questo file in .env e compila tutti i valori
# ============================================================

# --- SERVER ---
PORT=3001
NODE_ENV=development

# --- SUPABASE ---
# Trova in: Supabase Dashboard → Settings → API
SUPABASE_URL=https://xxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- STRIPE ---
# Trova in: stripe.com → Dashboard → Developers → API Keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Usa sk_live_... in produzione

# --- URL APPLICAZIONE ---
FRONTEND_URL=http://localhost:5173
# In produzione: https://tuodominio.com

# --- EMAIL (Nodemailer SMTP) ---
# Opzione A: Gmail (per test/piccolo volume)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=tuaemail@gmail.com
EMAIL_PASS=xxxx-xxxx-xxxx-xxxx   # Gmail App Password (2FA attivo)
EMAIL_FROM="Arfanta Bike Rental <tuaemail@gmail.com>"

# Opzione B: SendGrid
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USER=apikey
# EMAIL_PASS=SG.xxxxxxxxxx

# --- NOTIFICHE GESTORE ---
OWNER_EMAIL=tuaemail@example.com
OWNER_PHONE=+39 XXX XXXXXXX

# --- ADMIN DASHBOARD ---
# Token segreto per accedere al pannello admin (/admin)
# Genera con: openssl rand -hex 20
ADMIN_TOKEN=cambia-questo-con-una-stringa-casuale-lunga

# --- RATE LIMITING (Upstash Redis) ---
# Crea account gratuito su upstash.com → crea DB Redis → copia le credenziali
# Senza queste variabili il rate limiting non funziona su Vercel serverless
UPSTASH_REDIS_REST_URL=https://xxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxx

# --- BUSINESS INFO ---
BUSINESS_NAME=Arfanta Bike Rental
BUSINESS_ADDRESS=Via Pecol 22, Arfanta di Tarzo (TV)
BUSINESS_PHONE=+39 XXX XXXXXXX
